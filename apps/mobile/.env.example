# Copy to .env (not committed). EXPO_PUBLIC_* values are embedded in the app, never put secrets here.
# mock: work without the backend; live: use EXPO_PUBLIC_API_URL
EXPO_PUBLIC_API_MODE=mock
# On a phone use the laptop IP in the same Wi-Fi, e.g. http://192.168.1.10:8080
EXPO_PUBLIC_API_URL=http://localhost:8080
