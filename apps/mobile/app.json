{
  "expo": {
    "name": "AgroAdvisor KZ",
    "slug": "agroadvisor-kz",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "agroadvisor",
    "userInterfaceStyle": "light",
    "locales": {
      "ru": "./locales/ru.json",
      "kk": "./locales/kk.json",
      "en": "./locales/en.json"
    },
    "ios": {
      "bundleIdentifier": "kz.agroadvisor.mobile",
      "supportsTablet": false,
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "CFBundleLocalizations": ["ru", "kk", "en"]
      }
    },
    "android": {
      "package": "kz.agroadvisor.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#1E4D2B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1E4D2B",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-localization",
      "expo-font",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "AgroAdvisor использует камеру, чтобы сфотографировать больной лист для диагностики, а агрохимик — снять диплом или сертификат для проверки.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "AgroAdvisor открывает галерею, чтобы вы выбрали фото листа для диагностики, а агрохимик — фото диплома или сертификата для проверки.",
          "cameraPermission": "AgroAdvisor использует камеру, чтобы сфотографировать больной лист для диагностики, а агрохимик — снять диплом или сертификат для проверки.",
          "microphonePermission": false
        }
      ]
    ]
  }
}
