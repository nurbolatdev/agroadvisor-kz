  "info" : {
    "description" : "REST API for the mobile app and the admin panel. Errors use RFC 9457 Problem Details with a stable `code` property.",
    "title" : "AgroAdvisor KZ API",
    "version" : "0.1.0-SNAPSHOT"
  },
  "openapi" : "3.1.0",
  "paths" : {
    "/api/admin/agrochemists" : {
      "get" : {
        "operationId" : "queue",
        "parameters" : [ {
          "in" : "query",
          "name" : "status",
          "required" : false,
          "schema" : {
            "default" : "pending",
            "pattern" : "pending|approved|rejected|documents_requested",
            "type" : "string"
          }
        }, {
          "in" : "query",
          "name" : "page",
          "required" : false,
          "schema" : {
            "default" : 0,
            "format" : "int32",
            "maximum" : 10000,
            "minimum" : 0,
            "type" : "integer"
          }
        }, {
          "in" : "query",
          "name" : "size",
          "required" : false,
          "schema" : {
            "default" : 20,
            "format" : "int32",
            "maximum" : 100,
            "minimum" : 1,
            "type" : "integer"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "items" : {
                    "$ref" : "#/components/schemas/SummaryView"
                  },
                  "type" : "array"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Agrochemists with the given status (pending by default), the longest waiting first",
        "tags" : [ "agrochemist-admin-controller" ]
      }
    },
    "/api/admin/agrochemists/{userId}" : {
      "get" : {
        "operationId" : "details",
        "parameters" : [ {
          "in" : "path",
          "name" : "userId",
          "required" : true,
          "schema" : {
            "format" : "uuid",
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/DetailsView"
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [ "agrochemist-admin-controller" ]
      }
    },
    "/api/admin/agrochemists/{userId}/decision" : {
      "post" : {
        "operationId" : "decide",
        "parameters" : [ {
          "in" : "path",
          "name" : "userId",
          "required" : true,
          "schema" : {
            "format" : "uuid",
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/DecisionRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/DetailsView"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "approve (needs a document), reject or request_documents (both need a reason the agrochemist will see). Approving makes the agrochemist visible to farmers.",
        "tags" : [ "agrochemist-admin-controller" ]
      }
    },
    "/api/admin/agrochemists/{userId}/documents/{documentId}/file" : {
      "get" : {
        "operationId" : "file",
        "parameters" : [ {
          "in" : "path",
          "name" : "userId",
          "required" : true,
          "schema" : {
            "format" : "uuid",
            "type" : "string"
          }
        }, {
          "in" : "path",
          "name" : "documentId",
          "required" : true,
          "schema" : {
            "format" : "uuid",
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "format" : "byte",
                  "type" : "string"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "The document as it was sent (PDF, JPEG or PNG), as a download",
        "tags" : [ "agrochemist-admin-controller" ]
      }
    },
    "/api/admin/crops" : {
      "get" : {
        "operationId" : "crops",
        "responses" : {
          "200" : {
