    "/api/diagnoses" : {
      "get" : {
        "operationId" : "history",
        "parameters" : [ {
          "in" : "query",
          "name" : "page",
          "required" : false,
          "schema" : {
            "default" : 0,
            "format" : "int32",
            "minimum" : 0,
            "type" : "integer"
          }
        }, {
          "in" : "query",
          "name" : "size",
          "required" : false,
          "schema" : {
            "default" : 20,
            "format" : "int32",
            "maximum" : 100,
            "minimum" : 1,
            "type" : "integer"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "items" : {
                    "$ref" : "#/components/schemas/DiagnosisView"
                  },
                  "type" : "array"
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [ "diagnosis-controller" ]
      },
      "post" : {
        "operationId" : "create",
        "parameters" : [ {
          "in" : "query",
          "name" : "crop",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        }, {
          "description" : "One key per diagnosis attempt (a UUID fits); resend the same request with it when the answer was lost. The key is tied to the crop and to the exact photo bytes (SHA-256): another crop or another photo under the same key is 422 idempotency_key_reused with reason crop or photo, so a retry must send the same file. A malformed key is 400 invalid_idempotency_key. A repeat does not spend the diagnosis rate limit. While the first request with the key is still being processed, another one gets 409 request_in_progress with Retry-After: 2 (seconds); the model is not called again and the limit is not spent.",
          "in" : "header",
          "name" : "Idempotency-Key",
          "required" : false,
          "schema" : {
            "maxLength" : 80,
            "minLength" : 8,
            "pattern" : "[A-Za-z0-9_.:-]{8,80}",
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "multipart/form-data" : {
              "schema" : {
                "properties" : {
                  "image" : {
                    "format" : "binary",
                    "type" : "string"
                  }
                },
                "required" : [ "image" ],
                "type" : "object"
              }
            }
          }
        },
        "responses" : {
          "201" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/DiagnosisView"
                }
              }
            },
            "description" : "The diagnosis; for a repeated Idempotency-Key the one made the first time, with the header Idempotent-Replayed: true",
            "headers" : {
              "Idempotent-Replayed" : {
                "description" : "\"true\" when the diagnosis already existed",
                "schema" : {
                  "enum" : [ "true" ],
                  "type" : "string"
                },
                "style" : "simple"
              }
            }
          },
          "409" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/DiagnosisView"
                }
              }
            },
            "description" : "request_in_progress: a request with the same Idempotency-Key is still being processed; repeat after the seconds in Retry-After",
            "headers" : {
              "Retry-After" : {
                "description" : "Seconds to wait before repeating the request",
                "schema" : {
                  "example" : "2",
                  "type" : "string"
                },
                "style" : "simple"
              }
            }
          },
          "429" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/DiagnosisView"
                }
              }
            },
            "description" : "rate_limited: more than 20 attempts or more than 5 new diagnoses in a minute. Attempts are never given back; a diagnosis token is given back when the server failed (see docs/api/ai-predict.md). Repeat after the seconds in Retry-After",
            "headers" : {
              "Retry-After" : {
                "description" : "Seconds until the window of the limit ends",
                "schema" : {
                  "example" : "42",
                  "type" : "string"
                },
                "style" : "simple"
              }
            }
          }
        },
        "tags" : [ "diagnosis-controller" ]
      }
    },
