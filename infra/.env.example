# Copy to .env (same folder) and set your own values. .env is not committed.

# PostgreSQL + PostGIS
POSTGRES_DB=agroadvisor
POSTGRES_USER=agroadvisor
POSTGRES_PASSWORD=change-me
# Host port; 5433 avoids a clash with a locally installed PostgreSQL on 5432
POSTGRES_PORT=5433

# Redis
REDIS_PASSWORD=change-me
REDIS_PORT=6379

# SeaweedFS (S3-compatible photo storage)
S3_ACCESS_KEY=agroadvisor
S3_SECRET_KEY=change-me-too
S3_BUCKET=diagnosis-photos
S3_PORT=8333
S3_FILER_PORT=8888

# Backend: JWT signing secret, Base64 of at least 32 random bytes. Generate: openssl rand -base64 48
# Replace before the first start: the backend refuses to run with this placeholder
JWT_SECRET=change-me
