# Copy to .env and adjust. All variables are optional.

# Class registry and model weights
AI_CLASSES_PATH=ml/classes.yaml
AI_WEIGHTS_DIR=ml/weights

# Inference device: auto | cpu | cuda | mps
AI_DEVICE=auto

# Model: only "placeholder" (a fake model, not a classifier) exists so far
AI_MODEL_KIND=placeholder
# true = stop at startup if the model cannot be loaded; false = answer 503
AI_REQUIRE_MODEL=false

# Upload limits for POST /predict: file size in MiB, decoded size in pixels
AI_MAX_IMAGE_MB=10
AI_MAX_IMAGE_PIXELS=50000000

# Photo quality (preliminary): shorter side px, mean luminance 0-255, Laplacian variance
AI_MIN_IMAGE_SIDE=224
AI_MIN_BRIGHTNESS=40
AI_MIN_SHARPNESS=50

# Status thresholds (preliminary, finalized after calibration)
AI_OK_THRESHOLD=0.70
AI_LOW_THRESHOLD=0.40
AI_CROP_MISMATCH_THRESHOLD=0.70

# DEBUG | INFO | WARNING | ERROR
AI_LOG_LEVEL=INFO
